{
  "name": "@health.gov.au/health-design-system",
  "author": "Australian Government Department of Health and Aged Care <enquiries@health.gov.au> (https://www.health.gov.au)",
  "description": "Design system for health.gov.au and related products.",
  "version": "3.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/healthgovau/health-design-system.git"
  },
  "license": "GNU GENERAL PUBLIC LICENSE v3",
  "bugs": {
    "url": "https://github.com/healthgovau/health-design-system/issues"
  },
  "main": "index.js",
  "bin": {
    "healthds": "./bin/cli.js"
  },
  "dependencies": {
    "copy": "^0.3.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@drupal/once": "^1.0.1",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "del": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-yml": "^1.19.1",
    "gulp": "^5.0.0",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-babel": "^8.1.0",
    "gulp-clean-css": "^4.2.0",
    "gulp-concat": "^2.6.1",
    "gulp-copy": "^5.0.0",
    "gulp-debug": "^5.0.1",
    "gulp-header": "^2.0.9",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-terser": "^2.1.0",
    "handlebars": "^4.7.10",
    "prettier": "^3.10.1",
    "sass": "^1.77.8",
    "sass-versioning": "^0.4.5",
    "storybook": "^10.6.7",
    "vite": "^8.3.8"
  },
  "overrides": {
    "sass": {
      "immutable": "5.2.0"
    }
  },
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "start": "cat .githooks/pre-commit > .git/hooks/pre-commit && chmod a+x .git/hooks/pre-commit",
    "gulp": "gulp",
    "gulp:watch": "gulp watch",
    "fractal:start": "cd style-guide && fractal start --sync",
    "fractal:build": "npm run gulp && cd style-guide && fractal build",
    "playwright:build": "docker compose -f playwright/compose.yml build",
    "playwright:open": "playwright show-report playwright/report",
    "playwright:reference": "sh scripts/playwright_test_runner.sh reference",
    "playwright:run": "sh scripts/playwright_test_runner.sh",
    "playwright:ui": "node playwright/scripts/docker-ui.mjs",
    "storybook:run": "storybook dev -p 6006",
    "storybook:build": "storybook build -o docs",
    "storybook:docs": "storybook dev -p 6006 --docs",
    "storybook:test": "node --test storybook/*.test.mjs"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@2.6.12": true,
    "puppeteer@22.15.0": true,
    "esbuild@0.28.2": true
  }
}
